<div>
    <div class="progress" style="height:@(Height)px; border-radius:0.5rem;">
        <div class="progress-bar bg-success" role="progressbar"
             style="width:@(Pct.ToString(CultureInfo.InvariantCulture))%"
             aria-valuenow="@Pct" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <div class="d-flex justify-content-between mt-1">
        <small class="text-muted">@Fmt(Recaudado) de @Fmt(Objetivo)</small>
        <small class="fw-semibold text-success">@Porcentaje%</small>
    </div>
</div>

@code {
    [Parameter] public decimal Porcentaje { get; set; }
    [Parameter] public decimal Recaudado { get; set; }
    [Parameter] public decimal Objetivo { get; set; }
    [Parameter] public int Height { get; set; } = 10;

    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");

    private decimal Pct => Math.Clamp(Porcentaje, 0, 100);

    private string Fmt(decimal v) => "$" + v.ToString("N0", Ar);
}
