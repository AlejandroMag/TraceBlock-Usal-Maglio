@page "/rastrear"
@page "/rastrear/{Token}"
@inject DonacionService Donaciones
@inject IBlockchainService Blockchain

<PageTitle>Rastrear donación — TraceBlock</PageTitle>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold">Rastreá tu donación</h1>
        <p class="text-muted">Ingresá tu Token ID para verificar el registro en blockchain.</p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="input-group input-group-lg">
                <input class="form-control" placeholder="Ingresá tu Token ID..."
                       @bind="_token" @bind:event="oninput" @onkeyup="OnKey" />
                <button class="btn btn-primary" @onclick="Buscar" disabled="@_buscando">
                    @if (_buscando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else { <text>Buscar</text> }
                </button>
            </div>
        </div>
    </div>

    @if (_buscado && _donacion is null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="alert alert-warning">
                    No encontramos ninguna donación con ese Token ID.
                </div>
            </div>
        </div>
    }
    else if (_donacion is not null)
    {
        var p = _donacion.Proyecto;
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="blockchain-card text-white mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="mb-0"><i class="bi bi-shield-check text-success me-1"></i>Donación verificada</h5>
                        <span class="badge bg-success">@_donacion.Estado</span>
                    </div>
                    <TokenDisplay Token="@_donacion.TokenId" Label="Token ID" Color="yellow" />
                    <TokenDisplay Token="@_donacion.TxHashBlockchain" Label="Transaction Hash (Polygon)" Color="cyan" />
                </div>

                <div class="card mb-4"><div class="card-body">
                    <div class="row text-center mb-3">
                        <div class="col-6 border-end">
                            <div class="text-muted small">Donante</div>
                            <div class="fw-semibold">@(_donacion.Anonima ? "Anónimo" : _donacion.Usuario?.Nombre)</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Monto</div>
                            <div class="fs-4 fw-bold text-success">@Fmt(_donacion.Monto)</div>
                        </div>
                    </div>
                    <div class="mb-1"><strong>Proyecto:</strong> <a href="/proyecto/@p.Id">@p.Titulo</a></div>
                    <div class="mb-3"><strong>Organización:</strong> @p.Organizacion?.NombreOrganizacion</div>
                    <ProgressBar Porcentaje="p.PorcentajeAvance" Recaudado="p.MontoRecaudado" Objetivo="p.MontoObjetivo" />

                    <div class="mt-3">
                        @if (_verifDonacion is null)
                        {
                            <button class="btn btn-outline-success" @onclick="VerificarDonacion" disabled="@_verificandoDon">
                                @if (_verificandoDon)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <text> Verificando…</text>
                                }
                                else { <i class="bi bi-diagram-3 me-1"></i><text>Verificar en Polygon</text> }
                            </button>
                        }
                        else
                        {
                            <BlockchainBadge Verificado="_verifDonacion.Value" />
                            @if (_confirmaciones > 0)
                            {
                                <small class="text-muted ms-2">@_confirmaciones confirmaciones</small>
                            }
                        }
                    </div>
                </div></div>

                @if (p.Evidencias.Any())
                {
                    <h5 class="fw-bold mb-3">Evidencias del proyecto</h5>
                    @foreach (var ev in p.Evidencias)
                    {
                        <div class="card mb-2"><div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div><i class="bi bi-file-earmark-text me-1"></i>@ev.NombreArchivo
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@ev.TipoEvidencia</span></div>
                                @if (_verifEvidencia.TryGetValue(ev.Id, out var est) && est != null)
                                {
                                    <BlockchainBadge Verificado="est.Value" />
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" disabled="@_verifLoading.Contains(ev.Id)"
                                            @onclick="() => VerificarEvidencia(ev)">
                                        @if (_verifLoading.Contains(ev.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else { <text>Verificar</text> }
                                    </button>
                                }
                            </div>
                            <TokenDisplay Token="@ev.HashSHA256" Label="SHA-256" Color="green" Truncar="true" />
                        </div></div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Token { get; set; }
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");

    private string _token = "";
    private bool _buscando;
    private bool _buscado;
    private Donacion? _donacion;

    private bool? _verifDonacion;
    private bool _verificandoDon;
    private int _confirmaciones;

    private readonly Dictionary<int, bool?> _verifEvidencia = new();
    private readonly HashSet<int> _verifLoading = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Token) && string.IsNullOrEmpty(_token))
        {
            _token = Token;
            await Buscar();
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Buscar();
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(_token)) return;
        _buscando = true;
        _verifDonacion = null;
        _verifEvidencia.Clear();
        StateHasChanged();

        _donacion = await Donaciones.RastrearPorTokenAsync(_token);
        _buscado = true;
        _buscando = false;
        StateHasChanged();
    }

    private async Task VerificarDonacion()
    {
        if (_donacion is null) return;
        _verificandoDon = true;
        StateHasChanged();
        var r = await Blockchain.VerificarTransaccion(_donacion.TxHashBlockchain);
        _verificandoDon = false;
        _verifDonacion = r.Valido;
        _confirmaciones = r.Confirmaciones;
        StateHasChanged();
    }

    private async Task VerificarEvidencia(Evidencia ev)
    {
        _verifLoading.Add(ev.Id);
        StateHasChanged();
        var r = await Blockchain.VerificarTransaccion(ev.TxHashBlockchain);
        _verifLoading.Remove(ev.Id);
        _verifEvidencia[ev.Id] = r.Valido;
        StateHasChanged();
    }

    private static string Fmt(decimal v) => "$" + v.ToString("N0", Ar);
}
