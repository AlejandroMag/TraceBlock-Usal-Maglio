@page "/proyecto/{Id:int}"
@inject ProyectoService Proyectos
@inject IBlockchainService Blockchain
@inject NavigationManager Nav
@inject AppState AppState
@inject IJSRuntime JS

<PageTitle>@(_proyecto?.Titulo ?? "Proyecto") — TraceBlock</PageTitle>

@if (_proyecto is null)
{
    <div class="container py-5 text-center text-muted">Cargando proyecto…</div>
}
else
{
    <div class="container py-4">
        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA -->
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-info-subtle text-info-emphasis">@_proyecto.Categoria</span>
                    <small class="text-muted"><i class="bi bi-geo-alt-fill"></i> @_proyecto.CiudadProyecto</small>
                    <small class="text-muted">· @_proyecto.Organizacion?.NombreOrganizacion</small>
                </div>
                <h1 class="fw-bold">@_proyecto.Titulo</h1>

                <div class="my-3">
                    <ProgressBar Porcentaje="_proyecto.PorcentajeAvance" Recaudado="_proyecto.MontoRecaudado"
                                 Objetivo="_proyecto.MontoObjetivo" Height="20" />
                </div>

                <p class="text-secondary">@_proyecto.Descripcion</p>

                <!-- UBICACIÓN -->
                @if (_tieneUbicacion)
                {
                    <h4 class="fw-bold mt-4 mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Ubicación del proyecto</h4>
                    <div id="mapProyectoDetalle" style="height:320px;" class="mb-1"></div>
                    <small class="text-muted">@_proyecto.CiudadProyecto · @_proyecto.LatitudProyecto.ToString("F4", CultureInfo.InvariantCulture), @_proyecto.LongitudProyecto.ToString("F4", CultureInfo.InvariantCulture)</small>
                }

                <!-- HITOS -->
                <h4 class="fw-bold mt-4 mb-3">Hitos</h4>
                <div>
                    @foreach (var (h, idx) in _proyecto.Hitos.OrderBy(x => x.Orden).Select((h, i) => (h, i)))
                    {
                        <div class="d-flex gap-3">
                            <div class="d-flex flex-column align-items-center">
                                <span class="timeline-dot @(h.Completado ? "done" : "pending")"></span>
                                @if (idx < _proyecto.Hitos.Count - 1)
                                {
                                    <span class="timeline-line"></span>
                                }
                            </div>
                            <div class="pb-4 flex-grow-1">
                                <div class="fw-semibold">@h.Titulo</div>
                                <p class="small text-muted mb-1">@h.Descripcion</p>
                                @if (h.Completado)
                                {
                                    <small class="text-success"><i class="bi bi-check-circle"></i> Completado @(h.FechaCompletado?.ToString("dd/MM/yyyy"))</small>
                                }
                                else
                                {
                                    <small class="text-muted"><i class="bi bi-clock"></i> Objetivo: @(h.FechaObjetivo?.ToString("dd/MM/yyyy") ?? "—")</small>
                                }
                                @if (h.MontoReferencia is > 0)
                                {
                                    var pct = Math.Min(100, _proyecto.MontoRecaudado / h.MontoReferencia.Value * 100);
                                    <div class="progress mt-2" style="height:6px; max-width:300px;">
                                        <div class="progress-bar bg-secondary" style="width:@(((double)pct).ToString(CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <small class="text-muted">Referencia: @Fmt(h.MontoReferencia.Value)</small>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- NOVEDADES -->
                <h4 class="fw-bold mt-4 mb-3">Novedades</h4>
                @if (!_proyecto.Comunicados.Any())
                {
                    <p class="text-muted small">Todavía no hay novedades publicadas.</p>
                }
                else
                {
                    @foreach (var c in _proyecto.Comunicados.OrderByDescending(x => x.FechaPublicacion))
                    {
                        <div class="card mb-3"><div class="card-body">
                            <div class="d-flex gap-3">
                                <div class="comunicado-avatar">@Iniciales(_proyecto.Organizacion?.NombreOrganizacion)</div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong>@_proyecto.Organizacion?.NombreOrganizacion</strong>
                                        <small class="text-muted">· @c.FechaPublicacion.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="fw-bold mt-1">@c.Titulo</div>
                                    <p class="mb-0 text-secondary">@c.Cuerpo</p>
                                </div>
                            </div>
                        </div></div>
                    }
                }

                <!-- EVIDENCIAS -->
                <h4 class="fw-bold mt-4 mb-3">Evidencias</h4>
                @if (!_proyecto.Evidencias.Any())
                {
                    <p class="text-muted small">Todavía no hay evidencias cargadas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead><tr>
                                <th>Archivo</th><th>Tipo</th><th>SHA-256</th><th>TxHash</th><th>Fecha</th><th></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var ev in _proyecto.Evidencias)
                                {
                                    <tr>
                                        <td><i class="bi bi-file-earmark-text me-1"></i>@ev.NombreArchivo</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@ev.TipoEvidencia</span></td>
                                        <td><TokenDisplay Token="@ev.HashSHA256" Color="green" Truncar="true" /></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ev.TxHashBlockchain))
                                            {
                                                <TokenDisplay Token="@ev.TxHashBlockchain" Color="cyan" Truncar="true" />
                                            }
                                            else
                                            {
                                                <small class="text-muted">pendiente</small>
                                            }
                                        </td>
                                        <td><small>@ev.SubidoEn.ToString("dd/MM/yyyy")</small></td>
                                        <td>
                                            <BlockchainEstado @key="ev.Id" Red="@ev.RedBlockchain" Estado="@ev.EstadoBlockchain" TxHash="@ev.TxHashBlockchain"
                                                              Verificar="@(() => Blockchain.VerificarEvidencia(ev.TxHashBlockchain, ev.HashSHA256, ev.ProyectoId))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- COLUMNA DERECHA -->
            <div class="col-lg-4">
                <div class="card sticky-donate"><div class="card-body">
                    <div class="text-center mb-3">
                        <div class="fs-4 fw-bold text-success">@Fmt(_proyecto.MontoRecaudado)</div>
                        <small class="text-muted">de @Fmt(_proyecto.MontoObjetivo) objetivo</small>
                    </div>

                    <label class="form-label small">Elegí un monto</label>
                    <div class="row g-2 mb-2">
                        @foreach (var m in MontosRapidos)
                        {
                            <div class="col-4">
                                <div class="monto-quick text-center @(_monto == m ? "active" : "")" @onclick="() => _monto = m">
                                    @Fmt(m)
                                </div>
                            </div>
                        }
                    </div>
                    <div class="input-group mb-3">
                        <span class="input-group-text">$</span>
                        <input class="form-control" type="number" min="100" @bind="_monto" />
                    </div>

                    <button class="btn btn-primary w-100" @onclick="Donar">
                        <i class="bi bi-heart-fill me-1"></i>Donar ahora
                    </button>

                    <hr />
                    <h6 class="fw-bold">Últimos donantes</h6>
                    @{
                        var ultimos = _proyecto.Donaciones.OrderByDescending(d => d.FechaDonacion).Take(5).ToList();
                    }
                    @if (!ultimos.Any())
                    {
                        <small class="text-muted">Sé el primero en donar.</small>
                    }
                    else
                    {
                        @foreach (var d in ultimos)
                        {
                            <div class="d-flex justify-content-between border-bottom py-1">
                                <small>@(d.Anonima ? "Anónimo" : (d.Usuario?.Nombre ?? "Donante"))</small>
                                <small class="text-success fw-semibold">@Fmt(d.Monto)</small>
                            </div>
                            <small class="text-muted d-block mb-1" style="font-size:0.7rem;">@FechaRelativa(d.FechaDonacion)</small>
                        }
                    }
                </div></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    private static readonly decimal[] MontosRapidos = { 500, 1000, 2500, 5000, 10000 };

    private Proyecto? _proyecto;
    private decimal _monto = 1000;
    private bool _mapRendered;

    private bool _tieneUbicacion => _proyecto is not null
        && !(_proyecto.LatitudProyecto == 0 && _proyecto.LongitudProyecto == 0);

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Proyectos.ObtenerConDetalleAsync(Id);
        _mapRendered = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tieneUbicacion && !_mapRendered)
        {
            _mapRendered = true;
            await JS.InvokeVoidAsync("showLocationMap", "mapProyectoDetalle",
                _proyecto!.LatitudProyecto, _proyecto.LongitudProyecto, _proyecto.Titulo);
        }
    }

    private async Task Donar()
    {
        var state = await AuthState;
        if (state.User.Identity?.IsAuthenticated != true)
        {
            AppState.ShowLogin();
            return;
        }
        if (!state.User.IsInRole("Donante"))
        {
            AppState.ShowLogin();
            return;
        }
        Nav.NavigateTo($"/donar/{Id}");
    }

    private static string Fmt(decimal v) => "$" + v.ToString("N0", Ar);

    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "ON";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2
            ? $"{partes[0][0]}{partes[1][0]}".ToUpper()
            : nombre[..Math.Min(2, nombre.Length)].ToUpper();
    }

    private static string FechaRelativa(DateTime fecha)
    {
        var diff = DateTime.UtcNow - fecha;
        if (diff.TotalDays >= 1) return $"hace {(int)diff.TotalDays} día{((int)diff.TotalDays == 1 ? "" : "s")}";
        if (diff.TotalHours >= 1) return $"hace {(int)diff.TotalHours} h";
        if (diff.TotalMinutes >= 1) return $"hace {(int)diff.TotalMinutes} min";
        return "recién";
    }
}
