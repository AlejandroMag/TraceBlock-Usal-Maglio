@page "/donar/retorno"
@inject DonacionService Donaciones
@inject NavigationManager Nav

<PageTitle>Confirmando donación — TraceBlock</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            @if (_cargando)
            {
                <div class="card"><div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <h5>Confirmando tu pago con Mercado Pago…</h5>
                </div></div>
            }
            else if (_donacion is not null)
            {
                <div class="card"><div class="card-body">
                    <div class="text-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fade-check" style="font-size:4rem;"></i>
                        <h2 class="fw-bold mt-2">¡Donación registrada en blockchain!</h2>
                    </div>
                    <div class="blockchain-card text-white mb-3">
                        <TokenDisplay Token="@_donacion.TokenId" Label="Tu Token ID" Color="yellow" />
                        <TokenDisplay Token="@_donacion.TxHashBlockchain" Label="Transaction Hash (Polygon)" Color="cyan" />
                        @if (!string.IsNullOrEmpty(_donacion.PaymentId))
                        {
                            <TokenDisplay Token="@_donacion.PaymentId" Label="Payment ID (MercadoPago)" Color="green" />
                        }
                        <div class="d-flex justify-content-between mt-2">
                            <small>Monto: <strong>@Fmt(_donacion.Monto)</strong></small>
                            <small>Registrado: @_donacion.FechaDonacion.ToLocalTime().ToString("HH:mm")</small>
                        </div>
                    </div>
                    <div class="alert alert-warning small">
                        <i class="bi bi-shield-lock me-1"></i>Guardá tu Token ID — es tu comprobante permanente e irrefutable.
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary flex-fill" href="/dashboard">Ver mis donaciones</a>
                        <a class="btn btn-primary flex-fill" href="/rastrear/@_donacion.TokenId">Rastrear ahora</a>
                    </div>
                </div></div>
            }
            else
            {
                <div class="card"><div class="card-body text-center py-5">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem;"></i>
                    <h4 class="fw-bold mt-2">No pudimos confirmar el pago</h4>
                    <p class="text-muted">@_error</p>
                    <a class="btn btn-primary" href="/proyectos">Volver a proyectos</a>
                </div></div>
            }
        </div>
    </div>
</div>

@code {
    private bool _cargando = true;
    private Donacion? _donacion;
    private string _error = "El pago no se completó o fue rechazado.";
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");

    protected override async Task OnInitializedAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var tokenId = query.TryGetValue("external_reference", out var er) ? er.ToString() : "";
        var paymentId = query.TryGetValue("payment_id", out var pid) ? pid.ToString() : "";
        if (string.IsNullOrEmpty(paymentId) && query.TryGetValue("collection_id", out var cid))
            paymentId = cid.ToString();

        if (string.IsNullOrEmpty(tokenId))
        {
            _cargando = false;
            return;
        }

        var (donacion, error) = await Donaciones.FinalizarDonacionAsync(tokenId, paymentId);
        _donacion = donacion;
        if (donacion is null && !string.IsNullOrEmpty(error)) _error = error;
        _cargando = false;
    }

    private static string Fmt(decimal v) => "$" + v.ToString("N0", Ar);
}
