@page "/dashboard"
@attribute [Authorize(Roles = "Donante")]
@inject DonacionService Donaciones
@inject IBlockchainService Blockchain

<PageTitle>Mi panel — TraceBlock</PageTitle>

<div class="d-flex">
    <!-- SIDEBAR -->
    <div class="sidebar p-3 d-none d-md-block">
        <nav class="nav flex-column">
            <a class="nav-link active" href="/dashboard"><i class="bi bi-heart me-2"></i>Mis Donaciones</a>
            <a class="nav-link" href="/proyectos"><i class="bi bi-compass me-2"></i>Explorar</a>
            <a class="nav-link" href="/rastrear"><i class="bi bi-search me-2"></i>Rastrear</a>
            <a class="nav-link" href="/mis-donaciones"><i class="bi bi-list-ul me-2"></i>Listado simple</a>
        </nav>
    </div>

    <!-- CONTENIDO -->
    <div class="flex-grow-1 p-4">
        <h2 class="fw-bold mb-4">Mis Donaciones</h2>

        @if (_donaciones is null)
        {
            <p class="text-muted">Cargando…</p>
        }
        else if (_donaciones.Count == 0)
        {
            <div class="card"><div class="card-body text-center py-5">
                <i class="bi bi-heart fs-1 text-muted d-block mb-3"></i>
                <h5>Todavía no realizaste ninguna donación</h5>
                <a class="btn btn-primary mt-2" href="/proyectos">Explorar proyectos</a>
            </div></div>
        }
        else
        {
            @foreach (var grupo in _donaciones.GroupBy(d => d.ProyectoId))
            {
                var proyecto = grupo.First().Proyecto;
                var misDonaciones = grupo.OrderByDescending(d => d.FechaDonacion).ToList();
                var totalMio = grupo.Sum(d => d.Monto);
                var tab = TabActivo(proyecto.Id);
                <div class="card mb-4"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <h5 class="mb-1">@proyecto.Titulo</h5>
                            <small class="text-muted">@proyecto.Organizacion?.NombreOrganizacion · <i class="bi bi-geo-alt"></i> @proyecto.CiudadProyecto</small>
                        </div>
                        <span class="badge @EstadoBadge(proyecto.Estado)">@proyecto.Estado</span>
                    </div>

                    <div class="row g-2 my-3">
                        <div class="col-sm-4">
                            <div class="bg-success-subtle text-success-emphasis rounded p-2 text-center">
                                <div class="fw-bold fs-5">@Fmt(totalMio)</div>
                                <small>Donado por vos</small>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="bg-primary-subtle text-primary-emphasis rounded p-2 text-center">
                                <div class="fw-bold fs-5">@misDonaciones.Count</div>
                                <small>Tus aportes</small>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="bg-info-subtle text-info-emphasis rounded p-2 text-center">
                                <div class="fw-bold fs-5">@proyecto.Donaciones.Count</div>
                                <small>Donantes totales</small>
                            </div>
                        </div>
                    </div>

                    <ProgressBar Porcentaje="proyecto.PorcentajeAvance" Recaudado="proyecto.MontoRecaudado" Objetivo="proyecto.MontoObjetivo" />

                    <!-- TABS -->
                    <ul class="nav nav-tabs mt-3">
                        <li class="nav-item"><button class="nav-link @(tab == "movimientos" ? "active" : "")" @onclick='() => SetTab(proyecto.Id, "movimientos")'><i class="bi bi-wallet2 me-1"></i>Tus movimientos</button></li>
                        <li class="nav-item"><button class="nav-link @(tab == "donantes" ? "active" : "")" @onclick='() => SetTab(proyecto.Id, "donantes")'><i class="bi bi-people me-1"></i>Últimos donantes</button></li>
                        <li class="nav-item"><button class="nav-link @(tab == "hitos" ? "active" : "")" @onclick='() => SetTab(proyecto.Id, "hitos")'><i class="bi bi-flag me-1"></i>Hitos</button></li>
                        <li class="nav-item"><button class="nav-link @(tab == "comunicados" ? "active" : "")" @onclick='() => SetTab(proyecto.Id, "comunicados")'><i class="bi bi-megaphone me-1"></i>Comunicados</button></li>
                        <li class="nav-item"><button class="nav-link @(tab == "evidencias" ? "active" : "")" @onclick='() => SetTab(proyecto.Id, "evidencias")'><i class="bi bi-shield-check me-1"></i>Evidencias</button></li>
                    </ul>

                    <div class="border border-top-0 rounded-bottom p-3">
                        @switch (tab)
                        {
                            case "movimientos":
                                <h6 class="fw-bold mb-3">Tus donaciones a este proyecto</h6>
                                @foreach (var d in misDonaciones)
                                {
                                    <div class="blockchain-card text-white mb-3">
                                        @if (!string.IsNullOrWhiteSpace(d.Mensaje))
                                        {
                                            <p class="fst-italic text-warning-emphasis mb-2">“@d.Mensaje”</p>
                                        }
                                        <TokenDisplay Token="@d.TokenId" Label="Token ID" Color="yellow" />
                                        @if (!string.IsNullOrEmpty(d.TxHashBlockchain))
                                        {
                                            <TokenDisplay Token="@d.TxHashBlockchain" Label="Transaction Hash" Color="cyan" />
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <small>@Fmt(d.Monto) · @d.FechaDonacion.ToString("dd/MM/yyyy HH:mm") @(d.Anonima ? "· anónima" : "")</small>
                                            <BlockchainEstado @key="d.Id" Red="@d.RedBlockchain" Estado="@d.Estado" TxHash="@d.TxHashBlockchain" Oscuro="true"
                                                              Verificar="@(() => Blockchain.VerificarDonacion(d.TxHashBlockchain, d.TokenId, d.Monto, d.ProyectoId))" />
                                        </div>
                                    </div>
                                }
                                break;

                            case "donantes":
                                var ultimos = proyecto.Donaciones.OrderByDescending(d => d.FechaDonacion).Take(8).ToList();
                                @if (!ultimos.Any())
                                {
                                    <small class="text-muted">Todavía no hay donantes.</small>
                                }
                                else
                                {
                                    @foreach (var d in ultimos)
                                    {
                                        var mio = d.UsuarioId == _usuarioId;
                                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="comunicado-avatar" style="background:@(mio ? "#198754" : "#6c757d");">
                                                    @(d.Anonima ? "?" : Iniciales(d.Usuario?.Nombre + " " + d.Usuario?.Apellido))
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">
                                                        @(d.Anonima ? "Anónimo" : (d.Usuario?.Nombre ?? "Donante"))
                                                        @if (mio)
                                                        {
                                                            <span class="badge bg-success ms-1">vos</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted">@FechaRelativa(d.FechaDonacion)</small>
                                                </div>
                                            </div>
                                            <span class="text-success fw-bold">@Fmt(d.Monto)</span>
                                        </div>
                                    }
                                }
                                break;

                            case "hitos":
                                @foreach (var h in proyecto.Hitos.OrderBy(x => x.Orden))
                                {
                                    <div class="mb-3">
                                        @if (h.Completado)
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i><span style="text-decoration:line-through;">@h.Titulo</span></span>
                                            @if (h.FechaCompletado is not null)
                                            {
                                                <small class="text-muted ms-2">@h.FechaCompletado.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-clock me-1"></i>@h.Titulo</span>
                                        }
                                        @if (h.MontoReferencia is > 0)
                                        {
                                            var pct = Math.Min(100, (double)(proyecto.MontoRecaudado / h.MontoReferencia.Value * 100));
                                            <div class="progress mt-1" style="height:6px; max-width:320px;">
                                                <div class="progress-bar bg-secondary" style="width:@(pct.ToString(CultureInfo.InvariantCulture))%"></div>
                                            </div>
                                            <small class="text-muted">Referencia: @Fmt(h.MontoReferencia.Value)</small>
                                        }
                                    </div>
                                }
                                break;

                            case "comunicados":
                                @if (!proyecto.Comunicados.Any())
                                {
                                    <small class="text-muted">Sin comunicados.</small>
                                }
                                else
                                {
                                    @foreach (var c in proyecto.Comunicados.OrderByDescending(x => x.FechaPublicacion))
                                    {
                                        <div class="d-flex gap-3 mb-3">
                                            <div class="comunicado-avatar">@Iniciales(proyecto.Organizacion?.NombreOrganizacion)</div>
                                            <div>
                                                <small class="text-muted">@c.FechaPublicacion.ToString("dd/MM/yyyy")</small>
                                                <div class="fw-bold">@c.Titulo</div>
                                                <p class="mb-0 small text-secondary">@c.Cuerpo</p>
                                            </div>
                                        </div>
                                    }
                                }
                                break;

                            case "evidencias":
                                @if (!proyecto.Evidencias.Any())
                                {
                                    <small class="text-muted">Sin evidencias cargadas.</small>
                                }
                                else
                                {
                                    @foreach (var ev in proyecto.Evidencias)
                                    {
                                        <div class="border-bottom py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small><i class="bi bi-file-earmark-text me-1"></i>@ev.NombreArchivo
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@ev.TipoEvidencia</span>
                                                    · @ev.SubidoEn.ToString("dd/MM/yyyy")</small>
                                                <BlockchainEstado @key="ev.Id" Red="@ev.RedBlockchain" Estado="@ev.EstadoBlockchain" TxHash="@ev.TxHashBlockchain"
                                                                  Verificar="@(() => Blockchain.VerificarEvidencia(ev.TxHashBlockchain, ev.HashSHA256, ev.ProyectoId))" />
                                            </div>
                                            <TokenDisplay Token="@ev.HashSHA256" Color="green" Truncar="true" />
                                        </div>
                                    }
                                }
                                break;
                        }
                    </div>

                    <div class="mt-3">
                        <a class="btn btn-sm btn-outline-dark" href="/proyecto/@proyecto.Id"><i class="bi bi-box-arrow-up-right me-1"></i>Ver proyecto completo</a>
                    </div>
                </div></div>
            }
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");

    private List<Donacion>? _donaciones;
    private int _usuarioId;
    private readonly Dictionary<int, string> _tab = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _usuarioId = state.User.GetUserId();
        _donaciones = await Donaciones.ObtenerDonacionesUsuarioAsync(_usuarioId);
    }

    private string TabActivo(int id) => _tab.TryGetValue(id, out var t) ? t : "movimientos";
    private void SetTab(int id, string tab) => _tab[id] = tab;

    private static string Fmt(decimal v) => "$" + v.ToString("N0", Ar);

    private static string EstadoBadge(EstadoProyecto e) => e switch
    {
        EstadoProyecto.Activo => "bg-success",
        EstadoProyecto.Pausado => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "ON";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}".ToUpper() : nombre[..Math.Min(2, nombre.Length)].ToUpper();
    }

    private static string FechaRelativa(DateTime fecha)
    {
        var diff = DateTime.UtcNow - fecha;
        if (diff.TotalDays >= 1) return $"hace {(int)diff.TotalDays} día{((int)diff.TotalDays == 1 ? "" : "s")}";
        if (diff.TotalHours >= 1) return $"hace {(int)diff.TotalHours} h";
        if (diff.TotalMinutes >= 1) return $"hace {(int)diff.TotalMinutes} min";
        return "recién";
    }
}
