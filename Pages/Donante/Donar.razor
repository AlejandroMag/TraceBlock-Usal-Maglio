@page "/donar/{ProyectoId:int}"
@attribute [Authorize(Roles = "Donante")]
@inject ProyectoService ProyectoSvc
@inject DonacionService Donaciones
@inject NavigationManager Nav
@inject IBlockchainService Blockchain
@inject ValidacionesConfig Config
@inject TrazeaBlock.Services.MercadoPago.MercadoPagoConexionService Conexion

<PageTitle>Donar — TraceBlock</PageTitle>

@if (_proyecto is null)
{
    <div class="container py-5 text-center text-muted">Cargando…</div>
}
else
{
    <div class="container py-4">
        <div class="row g-4">
            <!-- IZQUIERDA: resumen -->
            <div class="col-lg-6">
                <div class="card"><div class="card-body">
                    <span class="badge bg-info-subtle text-info-emphasis mb-2">@_proyecto.Categoria</span>
                    <h4 class="fw-bold">@_proyecto.Titulo</h4>
                    <small class="text-muted">@_proyecto.Organizacion?.NombreOrganizacion</small>
                    <p class="text-secondary mt-2">@_proyecto.Descripcion</p>
                    <ProgressBar Porcentaje="_proyecto.PorcentajeAvance" Recaudado="_proyecto.MontoRecaudado" Objetivo="_proyecto.MontoObjetivo" />
                    <div class="mt-3">
                        @foreach (var h in _proyecto.Hitos.OrderBy(x => x.Orden))
                        {
                            <div class="small mb-1 @(h.Completado ? "hito-done" : "hito-pending")">@h.Titulo</div>
                        }
                    </div>
                </div></div>
            </div>

            <!-- DERECHA: formulario / estados -->
            <div class="col-lg-6">
                <div class="card"><div class="card-body">
                    @if (_fase == Fase.Form || _fase == Fase.Error)
                    {
                        @if (_fase == Fase.Error)
                        {
                            <div class="alert alert-danger py-2">@_error</div>
                        }

                        <h5 class="fw-bold mb-3">Tu donación</h5>
                        <label class="form-label small">Elegí un monto</label>
                        <div class="row g-2 mb-2">
                            @foreach (var m in MontosRapidos)
                            {
                                <div class="col-4 col-md">
                                    <div class="monto-quick text-center @(_monto == m ? "active" : "")" @onclick="() => _monto = m">@Fmt(m)</div>
                                </div>
                            }
                        </div>
                        <div class="input-group mb-3">
                            <span class="input-group-text">$</span>
                            <input class="form-control" type="number" min="100" @bind="_monto" />
                        </div>

                        <label class="form-label small">Mensaje opcional</label>
                        <textarea class="form-control mb-1" maxlength="200" rows="2" @bind="_mensaje" @bind:event="oninput"></textarea>
                        <div class="text-end small text-muted mb-2">@(_mensaje?.Length ?? 0)/200</div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="anon" @bind="_anonima" />
                            <label class="form-check-label" for="anon">Donación anónima</label>
                        </div>

                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-1"></i>
                            @if (_pagoReal)
                            {
                                <text>Vas a completar el pago en <strong>Mercado Pago</strong> (tarjeta o saldo). La donación entra directo en la cuenta de la organización y queda registrada en blockchain.</text>
                            }
                            else
                            {
                                <text>Tu pago se procesa con Mercado Pago. Luego se genera un <strong>Token ID</strong> único y el registro se graba en la blockchain de <strong>Polygon</strong>.</text>
                            }
                        </div>

                        @if (_pagoReal && !_orgConectada)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Esta organización todavía no configuró sus cobros con MercadoPago, así que aún no puede recibir donaciones.
                            </div>
                        }
                        else if (_pagoReal)
                        {
                            <button class="btn btn-primary w-100" @onclick="Pagar" disabled="@(_monto < 100)">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Pagar @Fmt(_monto) con Mercado Pago
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary w-100" @onclick="Confirmar" disabled="@(_monto < 100)">
                                Confirmar donación de @Fmt(_monto)
                            </button>
                        }
                    }
                    else if (_fase == Fase.Success && _resultado is not null)
                    {
                        <div class="text-center mb-3">
                            <i class="bi bi-check-circle-fill text-success fade-check" style="font-size:4rem;"></i>
                            @if (_resultado.Estado == "PendienteBlockchain")
                            {
                                <h2 class="fw-bold mt-2">¡Donación confirmada!</h2>
                                <p class="text-muted mb-0">El registro en Polygon se está completando; en unos minutos vas a poder verificarlo.</p>
                            }
                            else
                            {
                                <h2 class="fw-bold mt-2">¡Donación registrada en blockchain!</h2>
                            }
                        </div>
                        <div class="blockchain-card text-white mb-3">
                            <TokenDisplay Token="@_resultado.TokenId" Label="Tu Token ID" Color="yellow" />
                            @if (!string.IsNullOrEmpty(_resultado.TxHashBlockchain))
                            {
                                <TokenDisplay Token="@_resultado.TxHashBlockchain" Label="Transaction Hash (Polygon)" Color="cyan" />
                            }
                            <div class="mb-2">
                                <BlockchainEstado Red="@_resultado.RedBlockchain" Estado="@_resultado.Estado" TxHash="@_resultado.TxHashBlockchain" Oscuro="true"
                                                  Verificar="@(() => Blockchain.VerificarDonacion(_resultado!.TxHashBlockchain, _resultado.TokenId, _resultado.Monto, _resultado.ProyectoId))" />
                            </div>
                            @if (!string.IsNullOrEmpty(_resultado.PaymentId))
                            {
                                <TokenDisplay Token="@_resultado.PaymentId" Label="Payment ID (MercadoPago)" Color="green" />
                            }
                            <div class="d-flex justify-content-between mt-2">
                                <small>Monto: <strong>@Fmt(_resultado.Monto)</strong></small>
                                <small>Registrado: @_resultado.FechaDonacion.ToLocalTime().ToString("HH:mm")</small>
                            </div>
                        </div>
                        <div class="alert alert-warning small">
                            <i class="bi bi-shield-lock me-1"></i>
                            Guardá tu Token ID — es tu comprobante permanente e irrefutable.
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary flex-fill" href="/dashboard">Ver mis donaciones</a>
                            <a class="btn btn-primary flex-fill" href="/rastrear/@_resultado.TokenId">Rastrear ahora</a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <h5>@FaseTexto()</h5>
                        </div>
                    }
                </div></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private static readonly CultureInfo Ar = CultureInfo.GetCultureInfo("es-AR");
    private static readonly decimal[] MontosRapidos = { 500, 1000, 2500, 5000, 10000 };

    private enum Fase { Form, Pago, Token, Polygon, Redirigiendo, Success, Error }

    private Proyecto? _proyecto;
    private Fase _fase = Fase.Form;
    private decimal _monto = 1000;
    private string? _mensaje;
    private bool _anonima;
    private string _error = "";
    private Donacion? _resultado;
    private int _usuarioId;
    private bool _orgConectada;

    private bool _pagoReal => Config.ValidarPagoMercadoPago;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _usuarioId = state.User.GetUserId();
        _proyecto = await ProyectoSvc.ObtenerConDetalleAsync(ProyectoId);

        if (_pagoReal && _proyecto is not null)
            _orgConectada = await Conexion.EstaConectadaAsync(_proyecto.OrganizacionId);
    }

    // -------- Checkout Pro (marketplace, real) --------
    private async Task Pagar()
    {
        if (_monto < 100) { _error = "El monto mínimo es $100."; _fase = Fase.Error; return; }
        _fase = Fase.Redirigiendo;
        StateHasChanged();

        var (initPoint, error) = await Donaciones.IniciarDonacionCheckoutProAsync(
            _usuarioId, ProyectoId, _monto, _mensaje, _anonima, Nav.BaseUri);

        if (initPoint is null)
        {
            _error = error ?? "No se pudo iniciar el pago.";
            _fase = Fase.Error;
            StateHasChanged();
            return;
        }
        Nav.NavigateTo(initPoint, forceLoad: true);
    }

    // -------- Alta sin pasarela (ValidarPagoMercadoPago = false) --------
    private async Task Confirmar()
    {
        if (_monto < 100) { _error = "El monto mínimo es $100."; _fase = Fase.Error; return; }

        _fase = Fase.Pago; StateHasChanged();
        await Task.Delay(1000);
        _fase = Fase.Token; StateHasChanged();
        await Task.Delay(500);
        _fase = Fase.Polygon; StateHasChanged();

        var (donacion, error) = await Donaciones.CrearDonacionAsync(_usuarioId, ProyectoId, _monto, _mensaje, _anonima);
        if (donacion is null)
        {
            _error = error ?? "No se pudo registrar la donación.";
            _fase = Fase.Error;
            StateHasChanged();
            return;
        }
        _resultado = donacion;
        if (_proyecto is not null) _proyecto.MontoRecaudado += donacion.Monto;
        _fase = Fase.Success;
        StateHasChanged();
    }

    private string FaseTexto() => _fase switch
    {
        Fase.Pago => "Procesando pago…",
        Fase.Token => "Generando Token ID…",
        Fase.Polygon => "Registrando en Polygon…",
        Fase.Redirigiendo => "Redirigiéndote a Mercado Pago…",
        _ => "Procesando…"
    };

    private static string Fmt(decimal v) => "$" + v.ToString("N0", Ar);
}
