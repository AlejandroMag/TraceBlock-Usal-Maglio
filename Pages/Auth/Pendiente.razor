@page "/pendiente"
@attribute [Authorize(Roles = "Organizacion")]
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Estado de la organización — TraceBlock</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card"><div class="card-body p-4 text-center">
                @if (_cargando)
                {
                    <p class="text-muted mb-0">Verificando el estado de tu organización…</p>
                }
                else if (_org is null)
                {
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:3rem;"></i>
                    <h4 class="fw-bold mt-2">No encontramos tu organización</h4>
                    <p class="text-muted">No hay una organización asociada a esta cuenta.</p>
                    <a class="btn btn-primary" href="/">Volver al inicio</a>
                }
                else if (_org.Estado == EstadoValidacion.Rechazada)
                {
                    <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem;"></i>
                    <h4 class="fw-bold mt-2">Organización rechazada</h4>
                    <p class="text-muted">
                        La validación de <strong>@_org.NombreOrganizacion</strong> fue rechazada.
                        Si creés que es un error, contactate con el equipo de TraceBlock.
                    </p>
                    <a class="btn btn-outline-secondary" href="/">Volver al inicio</a>
                }
                else
                {
                    <i class="bi bi-hourglass-split text-secondary" style="font-size:3rem;"></i>
                    <h4 class="fw-bold mt-2">Tu organización está en revisión</h4>
                    <p class="text-muted">
                        <strong>@_org.NombreOrganizacion</strong> (CUIT @_org.CUIT) todavía no está habilitada
                        para publicar proyectos ni recibir donaciones.
                    </p>
                    <div class="alert alert-info text-start small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        La validación es automática: al registrarse, verificamos el CUIT contra el
                        <strong>Registro Nacional de Sociedades y Asociaciones sin Fines de Lucro</strong>.
                        Si llegaste a esta pantalla, escribinos para revisar el caso.
                    </div>
                    <a class="btn btn-outline-secondary" href="/">Volver al inicio</a>
                }
            </div></div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Organizacion? _org;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _org = await Auth.ObtenerOrganizacionPorUsuarioAsync(state.User.GetUserId());
        _cargando = false;

        // Si ya está validada, no tiene nada que hacer acá.
        if (_org is not null && _org.Estado == EstadoValidacion.Validada)
            Nav.NavigateTo("/ong/dashboard");
    }
}
